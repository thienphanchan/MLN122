# Copy to .env. Requires Node.js >=22.12; npm start reads .env automatically.
HOST=0.0.0.0
PORT=3001
# The reachable origin used by QR invitations, with no path or trailing hash.
# For classroom Wi-Fi, replace with this computer's real IPv4 address.
# PUBLIC_ORIGIN=http://192.168.1.10:3001
# For the dev server, use the Vite port: http://192.168.1.10:5173
# For Internet hosting: PUBLIC_ORIGIN=https://your-domain.example
# On Vercel, PUBLIC_ORIGIN may stay unset; QR uses the current website origin.
# Required on Vercel: add the provider's Redis connection URL in Vercel Settings.
# REDIS_URL=rediss://default:PASSWORD@HOST:6379
# Legacy KV_URL is also accepted. Never use VITE_REDIS_URL or commit credentials.
# Optional: override the default production/preview-specific Redis key namespace.
# ROOM_REDIS_PREFIX=cbcx:rooms:v1:production
# Local standalone mode only, when neither REDIS_URL nor KV_URL is configured:
ROOM_DATA_FILE=data/rooms.json
MAX_PLAYERS=100
ROOM_TTL_HOURS=24
